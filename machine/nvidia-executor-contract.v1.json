{
  "schema": "qsol.mesh.nvidia-executor-contract.v1",
  "contract_version": "1.0.0",
  "executor_id": "qsol-mesh-cuda-smoke-v1",
  "backend": "nvidia-cuda",
  "worker_protocol": "qsol.mesh.cuda-smoke-worker.v1",
  "workload_identity": "mesh-smoke-v1",
  "execution_contract": {
    "real_cuda_kernel_required": true,
    "cuda_api_device_selection_required": true,
    "device_side_work_required": true,
    "device_side_checksum_accumulation": "wrapping-u64-local-sums-plus-atomicAdd",
    "host_scalar_fallback_inside_cuda_worker_allowed": false,
    "requested_device_must_match_observed_device": true,
    "requested_items_must_match_worker_items": true,
    "worker_exit_success_required": true,
    "single_exact_protocol_line_required": true,
    "protocol_may_have_at_most_one_line_terminator": true,
    "verified_run_provenance_must_be_launcher_issued": true,
    "logical_id_iteration_must_not_wrap_u64": true,
    "verified_worker_location": "application-target-directory/mesh-cuda-smoke",
    "verified_worker_resolution": "canonicalized-current-executable-nearest-target-ancestor",
    "caller_working_directory_may_influence_verified_worker_resolution": false,
    "verified_worker_override_allowed": false,
    "verified_worker_environment_override_allowed": false,
    "arbitrary_helper_stdout_may_issue_verified_receipt": false
  },
  "observation_contract": {
    "device_ordinal_required": true,
    "compute_capability_required": true,
    "cuda_runtime_version_required": true,
    "cuda_driver_version_required": true,
    "evidence_source": "cuda-helper-process",
    "helper_reported_topology_is_independently_attested": false
  },
  "verification_contract": {
    "kind": "mesh-smoke-v1-scalar-reference-equality",
    "rust_launcher_recomputes_scalar_reference": true,
    "worker_checksum_must_equal_scalar_reference": true,
    "verified_receipt_requires_oracle_pass": true,
    "receipt_revalidates_resolved_worker_path": true
  },
  "build_contract": {
    "source": "accelerators/cuda/mesh_smoke_cuda.cu",
    "build_script": "scripts/build-cuda-helper.sh",
    "compiler": "nvcc",
    "verified_output": "target/mesh-cuda-smoke",
    "alternate_verified_output_allowed": false
  },
  "memory_contract": {
    "accelerator_checksum_buffer_bytes": 8,
    "per_item_device_materialization": false,
    "persistent_accelerator_pool": false,
    "pinned_host_staging": false
  },
  "trust_boundary": {
    "caller_selected_executables_are_execution_evidence": false,
    "caller_working_directory_is_execution_authority": false,
    "application_anchored_canonical_worker_is_required": true,
    "local_filesystem_and_build_environment_are_outside_this_contract": true,
    "canonical_path_is_not_cryptographic_binary_attestation": true
  },
  "ci_boundary": {
    "default_github_runner_has_cuda_execution_evidence": false,
    "ci_may_validate_rust_protocol_and_fail_closed_behavior": true,
    "ci_may_claim_gpu_execution_without_cuda_capable_runner": false
  },
  "evidence_status": "runtime-only-until-cuda-capable-host-receipt-is-retained",
  "claim_boundary": "Experimental single-device NVIDIA CUDA execution for mesh-smoke-v1. Verified physical-execution claims are admitted only through the application-anchored canonical worker resolved independently of the caller working directory, after successful worker execution, strict protocol validation, and independent scalar-oracle equality. Caller-selected executables and caller CWD cannot mint verified CUDA receipts. Helper-reported topology is not independently attested, and this is not performance evidence."
}
