{
  "schema": "qsol.mesh.calibrated-plan-contract.v1",
  "contract_version": "1.0.0",
  "plan_identity": "mesh-calibration-smoke-v1",
  "executed_workload_identity": "mesh-smoke-v1",
  "candidate_contract": {
    "maximum_candidates": 4,
    "candidate_ids_are_deterministic_contiguous_indices": true,
    "canonical_candidate_required": true,
    "exactly_one_canonical_candidate": true,
    "hardware_model_name_may_select_candidate": false,
    "accelerator_candidate_requires_observed_accelerator": true,
    "heterogeneous_candidate_requires_observed_accelerator": true
  },
  "measurement_contract": {
    "measured_evidence_required": true,
    "verified_checksum_required": true,
    "all_calibration_candidates_must_be_measured": true,
    "requested_repeat_count_must_be_recorded": true,
    "effective_cpu_workers_must_be_recorded": true,
    "cost_fields": [
      "service_ns",
      "setup_ns",
      "transfer_ns"
    ],
    "total_cost_is_checked_sum": true,
    "cpu_smoke_service_scope": "end-to-end-run-including-thread-lifecycle",
    "cpu_smoke_setup_ns": "zero-because-not-separately-modeled",
    "cpu_smoke_transfer_ns": "zero-because-no-cross-domain-transfer",
    "cpu_smoke_nonzero_setup_or_transfer_is_admissible": false,
    "accelerator_measurement_status": "admitted-only-by-calibrated-plan-contract.v2",
    "accelerator_timing_receipt_schema": "qsol.mesh.cuda-smoke-receipt.v2",
    "accelerator_measurements_admitted_by_planner": false,
    "opt_in_cuda_contract": "machine/calibrated-plan-contract.v2.json"
  },
  "oracle_contract": {
    "kind": "mesh-smoke-v1-scalar-reference-equality",
    "calibration_canonical_must_match_smoke_reference": true,
    "confirmation_canonical_must_match_smoke_reference": true,
    "peer_checksum_equality_cannot_replace_workload_oracle": true
  },
  "search_contract": {
    "kind": "deterministic-min-total-cost-v1",
    "tie_break": "lowest-candidate-id",
    "bounded_candidate_budget": true,
    "adaptive_work_stealing": false
  },
  "confirmation_contract": {
    "full_work_confirmation_required_before_noncanonical_promotion": true,
    "full_work_must_not_be_smaller_than_calibration_work": true,
    "canonical_confirmation_required": true,
    "provisional_noncanonical_confirmation_required": true,
    "confirmation_checksum_must_match_canonical": true,
    "unexpected_confirmation_observations_allowed": false
  },
  "near_tie_contract": {
    "default_basis_points": 500,
    "comparison": "strict-improvement-greater-than-margin",
    "canonical_retained_on_equal_or-near-tie": true,
    "canonical_restored_if_full-work-confirmation-falls-within-margin": true
  },
  "receipt_contract": {
    "schema": "qsol.mesh.calibrated-plan-receipt.v1",
    "must_include_existing_evidence_sections": true,
    "must_record_executed_workload_identity": true,
    "must_keep_plan_identity_separate_from_workload_identity": true,
    "must_record_requested_repeat_count": true,
    "must_record_observed_topology": true,
    "must_record_candidate_set": true,
    "must_record_calibration_observations": true,
    "must_record_effective_cpu_workers_per_observation": true,
    "must_record_full_work_confirmation": true,
    "must_record_provisional_and_final_selection": true,
    "must_record_selected_requested_and_effective_cpu_workers": true,
    "must_record_near_tie_margin": true,
    "serializer_must_revalidate_plan_before_verified_status": true
  },
  "claim_boundary": "Default CPU-only host-specific measured planning evidence. This v1 activation does not admit accelerator measurements; mesh calibrate smoke --cuda is governed by calibrated-plan-contract.v2.json. No hardware model name is performance authority.",
  "activation": "mesh-calibrate-smoke-without---cuda"
}
