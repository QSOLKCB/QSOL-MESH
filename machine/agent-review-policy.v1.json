{
  "schema":"qsol.mesh.agent-review-policy.v1",
  "policy_version":"1.0.0",
  "review_target":{"required_binding":"exact_commit_sha","review_must_state_sha":true,"moving_branch_head_is_not_sufficient":true},
  "blocking_finding_requirements":{
    "must_be_actionable_correctness_defect":true,
    "must_bind_existing_contract_or_invariant":true,
    "must_include_minimal_reproduction":true,
    "must_include_expected_behavior":true,
    "must_include_actual_behavior":true,
    "must_include_affected_file_and_lines":true,
    "must_state_reproduction_status":["executed","statically-inferred"],
    "must_identify_new_failing_case_if_previously_reported":true,
    "must_use_input_admitted_by_declared_grammar_or_api":true
  },
  "forbidden_blocking_patterns":[
    {"id":"REVIEW-NO-001","rule":"do_not_repeat_fixed_finding_without_new_failing_case"},
    {"id":"REVIEW-NO-002","rule":"do_not_promote_architectural_preference_to_correctness_blocker"},
    {"id":"REVIEW-NO-003","rule":"do_not_require_support_for_inputs_outside_declared_grammar_or_api"},
    {"id":"REVIEW-NO-004","rule":"do_not_create_parser_archaeology_from_hypothetical_invalid_inputs"},
    {"id":"REVIEW-NO-005","rule":"do_not_expand_scope_beyond_pr_and_existing_contract_as_blocking_review"},
    {"id":"REVIEW-NO-006","rule":"do_not_call_defense_in_depth_issue_correctness_defect_without_contract_violation_and_reproduction"},
    {"id":"REVIEW-NO-007","rule":"do_not_request_rewrite_when_minimal_correct_fix_exists"},
    {"id":"REVIEW-NO-008","rule":"do_not_treat_unmeasured_performance_speculation_as_performance_regression"}
  ],
  "non_blocking_channel":{"name":"architectural_suggestions","allowed":true,"must_be_separate_from_correctness_findings":true,"must_be_labeled_non_blocking":true},
  "finding_schema":{
    "required_fields":["severity","contract_id","file","lines","reproduction","reproduction_status","expected","actual","actionable_fix"],
    "reproduction_status_enum":["executed","statically-inferred"],
    "severity_enum":["P0","P1","P2","P3"]
  },
  "canonical_review_instruction":"Review this exact SHA against the existing contract. Report only actionable correctness defects, with a minimal reproduction, expected versus actual behavior, and affected lines. State whether each reproduction was executed or statically inferred. Don’t repeat fixed findings without a new failing case. Keep architectural suggestions separate and non-blocking.",
  "completion":{"no_actionable_defects_text":"No actionable correctness defects found against the existing contract.","must_not_invent_finding_to_avoid_empty_review":true}
}
